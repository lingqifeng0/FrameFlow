<Window
    x:Name="ConfWindow1"
    x:Class="MpvNet.Windows.WPF.ConfWindow"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:controls="clr-namespace:MpvNet.Windows.WPF.Controls"
    xmlns:wpf="clr-namespace:MpvNet.Windows.WPF"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d"
    
    Title="设置"
    Height="720"
    Width="1000"
    MinWidth="760"
    MinHeight="520"
    FontFamily="Microsoft YaHei UI"
    FontSize="13"
    Foreground="{Binding Theme.Foreground}"
    Background="{Binding Theme.Background}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    Loaded="ConfWindow1_Loaded"
    >

    <Window.Resources>
        <wpf:BindingProxy x:Key="BindingProxy" Data="{Binding}" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="n" Modifiers="Ctrl" Command="{Binding ShowMpvNetSpecificSettingsCommand}"/>
        <KeyBinding Key="F5" Command="{Binding PreviewMpvConfFileCommand}"/>
        <KeyBinding Key="F6" Command="{Binding PreviewMpvNetConfFileCommand}"/>
        <KeyBinding Key="F1" Modifiers="Ctrl" Command="{Binding ShowMpvManualCommand}"/>
        <KeyBinding Key="F2" Modifiers="Ctrl" Command="{Binding ShowMpvNetManualCommand}"/>
    </Window.InputBindings>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" BorderBrush="#282E3A" BorderThickness="0,0,0,1">
            <Grid Margin="24,13">
                <StackPanel>
                    <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="播放与鼠标、视频、音频及底层参数" Foreground="#97A2B4" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#203653" CornerRadius="6" Padding="12,5">
                    <TextBlock Text="{x:Static wpf:ConfWindow.VersionText}" Foreground="#6FA7FF" FontSize="14" />
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#171A21" BorderBrush="#282E3A" BorderThickness="0,0,1,0" />
        <controls:SearchControl
            x:Name="SearchControl"
            Grid.Row="1"
            VerticalAlignment="Top"
            HintText="全局搜索（Ctrl+F）"
            Margin="14,16,14,0"
            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            />
        <TextBlock Grid.Row="1" Margin="20,56,14,0" VerticalAlignment="Top" Text="例：倍速、断点、截图、硬解" FontSize="11" Foreground="#97A2B4" />
        
        <Grid Grid.Row="1" Grid.Column="1" Margin="22,16,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="SearchResultsBar" Visibility="Collapsed" Background="#171A21" BorderBrush="#282E3A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button x:Name="PreviousResultButton" Content="↑ 上一个" Width="88" Height="32" AutomationProperties.AutomationId="PreviousSearchResult" Click="PreviousResult_Click" ToolTip="Shift+Enter / Shift+F3" Padding="10,5" Margin="8,0,0,0" />
                            <Button x:Name="NextResultButton" Content="↓ 下一个" Width="88" Height="32" AutomationProperties.AutomationId="NextSearchResult" Click="NextResult_Click" ToolTip="Enter / F3" Padding="10,5" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="SearchResultCount" VerticalAlignment="Center" Foreground="#6FA7FF" FontSize="14" />
                    </DockPanel>
                    <TextBlock x:Name="SearchResultLocation" TextWrapping="Wrap" Foreground="#97A2B4" Margin="0,10,0,0" />
                    <TextBlock Text="Enter 下一个 · Shift+Enter 上一个 · 清空搜索返回分类" Foreground="#97A2B4" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        <ScrollViewer
            Name="MainScrollViewer"
            VerticalScrollBarVisibility="Auto"
            Grid.Row="1"
            >
            
            <StackPanel>
                <TextBlock x:Name="SearchEmptyMessage" Visibility="Collapsed" Text="没有找到相关设置。试试“倍速”“断点”“双击”“截图”，也可以输入参数名称。" TextWrapping="Wrap" Foreground="#97A2B4" Margin="8,12" />
                <StackPanel x:Name="MainStackPanel" />
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <TreeView
            x:Name="TreeView"
            ItemsSource="{Binding Nodes}"
            Margin="14,82,14,12"
            Grid.Row="1"
            BorderThickness="0"
            Foreground="{Binding Theme.Foreground}"
            Background="#171A21"
            SelectedItemChanged="TreeView_SelectedItemChanged"
            PreviewMouseLeftButtonUp="TreeView_CategoryClick"
            >

            <TreeView.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.Theme.Background}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.Theme.Background}" />
            </TreeView.Resources>
            
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Padding" Value="5,6" />
                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.Theme.Foreground2}" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Background" Value="#282E3A" />
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=DataContext.Theme.Foreground}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" />
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#282E3A" BorderThickness="0,1,0,0" />
        <TextBlock Name="DefaultsStatus" Grid.Row="2" Grid.Column="1" Text="底层参数在关闭窗口时保存；部分选项需重启生效。"
            Foreground="#97A2B4" FontSize="12" VerticalAlignment="Center" Margin="22,0,312,0" TextWrapping="Wrap" />
        <Button Name="RestoreAllDefaultsButton" Grid.Row="2" Grid.Column="1" Content="恢复所有设置默认值" Width="178" Height="34" HorizontalAlignment="Right"
            Margin="0,0,120,0" Click="RestoreAllDefaults_Click" ToolTip="恢复全部设置，保留断点、书签及最近文件；自动备份原配置。底层参数重启后完整生效。" />
        <Button Grid.Row="2" Grid.Column="1" Content="完成" Width="84" Height="34" HorizontalAlignment="Right"
            Margin="0,0,22,0" Foreground="#ECEFF5" Background="#203653" Click="Done_Click" />
        <TextBlock
            Name="MenuTextBlock"
            Text="更多选项"
            Cursor="Hand"
            Foreground="#97A2B4"
            HorizontalAlignment="Center"
            Margin="14,0"
            VerticalAlignment="Center"
            Grid.Row="2"
            >

            <TextBlock.ContextMenu>
                <ContextMenu Name="MainContextMenu">
                    <MenuItem
                        Header="查看播放器专用参数"
                        Command="{Binding Data.ShowMpvNetSpecificSettingsCommand, Source={StaticResource BindingProxy}}"
                        />
                    <Separator />
                    <MenuItem
                        Header="预览 mpv.conf"
                        Command="{Binding Data.PreviewMpvConfFileCommand, Source={StaticResource BindingProxy}}"
                        />
                    <MenuItem
                        Header="预览 FrameFlow 配置"
                        Command="{Binding Data.PreviewMpvNetConfFileCommand, Source={StaticResource BindingProxy}}"
                        />
                    <Separator />
                    <MenuItem
                        Header="查看 mpv 文档"
                        Command="{Binding Data.ShowMpvManualCommand, Source={StaticResource BindingProxy}}"
                        />
                    <MenuItem
                        Header="查看 FrameFlow 使用说明"
                        Command="{Binding Data.ShowMpvNetManualCommand, Source={StaticResource BindingProxy}}"
                        />
                </ContextMenu>
            </TextBlock.ContextMenu>
            
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="MouseLeftButtonDown">
                    <b:ChangePropertyAction TargetObject="{Binding ContextMenu, ElementName=MenuTextBlock}"
                                            PropertyName="PlacementTarget"
                                            Value="{Binding ElementName=MenuTextBlock, Mode=OneWay}"/>
                    <b:ChangePropertyAction TargetObject="{Binding ContextMenu, ElementName=MenuTextBlock}"
                                            PropertyName="IsOpen"
                                            Value="True"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </TextBlock>
        
    </Grid>
</Window>

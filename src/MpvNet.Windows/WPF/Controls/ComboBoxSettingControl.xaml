<UserControl
    x:Name="ComboBoxSettingControl1"
    x:Class="MpvNet.Windows.WPF.ComboBoxSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:MpvNet.Windows.WPF"
    mc:Ignorable="d"
    
    d:DesignHeight="450"
    d:DesignWidth="800">
    
    <Border Background="#171A21" BorderBrush="#282E3A" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
        <StackPanel>
            <TextBox
                x:Name="TitleTextBox"
                FontSize="18"
                FontWeight="SemiBold"
                Margin="0,0,0,14"
                BorderThickness="0"
                IsReadOnly="True"
                Foreground="{Binding Theme.Foreground}"
                Background="Transparent"
                />

            <ComboBox
                Name="ComboBoxControl"
                MinWidth="300"
                MaxWidth="450"
                MinHeight="34"
                HorizontalAlignment="Left"
                MaxDropDownHeight="420"
                Foreground="{Binding Theme.Foreground}"
                Background="#0D0F13"
 
                SelectionChanged="ComboBoxControl_SelectionChanged"
                >
                <ComboBox.ItemTemplateSelector>
                    <local:ComboBoxTemplateSelector/>
                </ComboBox.ItemTemplateSelector>

                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Style.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Style.Resources>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <TextBox
                x:Name="HelpTextBox"
                TextWrapping="Wrap"
                FontSize="12"
                BorderThickness="0"
                IsReadOnly="True"
                Margin="0,10,0,0"
                Foreground="{Binding Theme.Foreground2}"
                Background="Transparent"
                />
            
            <TextBlock
                x:Name="LinkTextBlock"
                Margin="2,10,0,0"
                >
                <local:HyperlinkEx
                    x:Name="Link"
                    Foreground="{Binding Theme.Heading}"
                    />
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>

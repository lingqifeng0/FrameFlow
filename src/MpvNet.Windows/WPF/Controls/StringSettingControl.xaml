<UserControl
    x:Name="StringSettingControl1"
    x:Class="MpvNet.Windows.WPF.StringSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:MpvNet.Windows.WPF"
    mc:Ignorable="d" 
    d:DesignHeight="450"
    d:DesignWidth="800">
    
    <Border Background="#171A21" BorderBrush="#282E3A" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,14">
        <StackPanel>
            <TextBox
                x:Name="TitleTextBox"
                FontSize="18"
                FontWeight="SemiBold"
                Margin="0,0,0,14"
                BorderThickness="0"
                IsReadOnly="True"
                Foreground="{Binding Theme.Foreground}"
                Background="Transparent"
                />
            
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ValueTextBox"
                    Text="{Binding Path=Text, ElementName=StringSettingControl1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Width="300"
                    MinHeight="34"
                    FontSize="13"
                    Padding="7,5"
                    HorizontalAlignment="Left"
                    Foreground="{Binding Theme.Foreground}"
                    Background="#0D0F13"
                    CaretBrush="{Binding Theme.Foreground}"
                    TextChanged="ValueTextBox_TextChanged"
                    />

                <Button
                    x:Name="Button"
                    Width="34"
                    Height="34"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Click="Button_Click"
                    >...
                </Button>
            </Grid>

            <TextBox
                x:Name="HelpTextBox"
                TextWrapping="Wrap"
                FontSize="12"
                BorderThickness="0"
                IsReadOnly="True"
                Foreground="{Binding Theme.Foreground2}"
                Background="Transparent"
                />

            <TextBlock
                x:Name="LinkTextBlock"
                Margin="2,10,0,0"
                >
                <local:HyperlinkEx
                    x:Name="Link"
                    Foreground="{Binding Theme.Heading}"
                    />
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
